{
  "name": "ine-price-tracker-backend",
  "version": "1.0.0",
  "description": "Backend API and scraper for INE Product Price Tracker",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "lint": "eslint \"src/**/*.js\" \"tests/**/*.js\" --no-error-on-unmatched-pattern",
    "lint:fix": "eslint \"src/**/*.js\" \"tests/**/*.js\" --fix --no-error-on-unmatched-pattern",
    "scrape:once": "node scripts/scrapeOnce.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "eslint": "^9.26.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "nock": "^14.0.4"
  }
}
