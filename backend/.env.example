# Server
PORT=3001

# Supabase — get from https://app.supabase.com > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Dedicated Supabase test project, used only by db.integration.test.js.
# Its URL must differ from the normal/development SUPABASE_URL.
TEST_SUPABASE_URL=https://your-test-project-ref.supabase.co
TEST_SUPABASE_SERVICE_ROLE_KEY=your-test-service-role-key-here
# Keep false by default. The integration suite is skipped unless this is true
# and both TEST_SUPABASE_* variables are valid and non-empty.
RUN_DB_TESTS=false

# Cron authentication — a random strong secret shared with cron-job.org
CRON_SECRET=your-strong-random-secret-here

# INE mock store base URL
INE_BASE_URL=https://demo.inelabteamdev.com

# Optional existing tracked product UUID for a manual scrape-and-persist run
# (or pass it to scrape:once as npm run scrape:once -- <trackedProductId>)
SCRAPE_TRACKED_PRODUCT_ID=

# Set to false to watch the browser during a local manual scrape
PLAYWRIGHT_HEADLESS=true

# Node environment
NODE_ENV=development

# Optional log threshold: debug, info, warn, error, or silent.
# Defaults to debug outside production and info in production.
LOG_LEVEL=debug

# Frontend URL for CORS (set to your Vercel URL in production)
FRONTEND_URL=http://localhost:5173
