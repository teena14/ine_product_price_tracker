# Server
PORT=3001

# Supabase — get from https://app.supabase.com > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cron authentication — a random strong secret shared with cron-job.org
CRON_SECRET=your-strong-random-secret-here

# INE mock store base URL
INE_BASE_URL=https://demo.inelabteamdev.com

# Optional manual Playwright scrape target (or pass both values to scrape:once)
SCRAPE_PRODUCT_ID=
SCRAPE_OPTION_ID=

# Set to false to watch the browser during a local manual scrape
PLAYWRIGHT_HEADLESS=true

# Node environment
NODE_ENV=development

# Optional log threshold: debug, info, warn, error, or silent.
# Defaults to debug outside production and info in production.
LOG_LEVEL=debug

# Frontend URL for CORS (set to your Vercel URL in production)
FRONTEND_URL=http://localhost:5173
